# Per-machine environments that pixi recreates from pixi.lock.
.pixi/
# Bytecode caches regenerated by Python.
__pycache__/
# Package metadata that setuptools writes when pixi installs wuji_sim as an editable package.
*.egg-info/
# Run records, images, videos and CSVs written by the examples; regenerate them by running the examples.
artifacts/
